// Esquema de la base de datos. Cada cambio se aplica con una migración:
//   npm run db:migrate -- --name <descripcion>
// Los valores fijos (estados, prioridades) se guardan como texto y se validan
// con las constantes de @hogar/shared.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

// ---------- Usuarios y hogar ----------

/// Una casa. Cada persona puede estar en varias.
model Household {
  id            String            @id @default(uuid())
  name          String
  /// Secciones que la casa no usa, separadas por comas (claves de MODULES en @hogar/shared).
  /// Se ocultan pero no se borra nada. Vacío: se ven todas.
  hiddenModules String            @default("")
  createdAt     DateTime          @default(now())
  members       HouseholdMember[]
  invitations   Invitation[]
  tasks         Task[]
  ideas         Idea[]
  recurring     RecurringTask[]
  shopping      ShoppingItem[]
  products      ShoppingProduct[]
  recipes       Recipe[]
  menu          MenuEntry[]
  expenses      Expense[]
  settlements   Settlement[]
  bills         Bill[]
}

model User {
  id           String   @id @default(uuid())
  /// Siempre en minúsculas
  email        String   @unique
  name         String
  /// null en cuentas creadas con Google que no tienen contraseña
  passwordHash String?
  /// Identificador de la cuenta de Google conectada (claim "sub")
  googleId     String?  @unique
  createdAt    DateTime @default(now())

  memberships       HouseholdMember[]
  sessions          Session[]
  invitations       Invitation[]            @relation("InvitationCreatedBy")
  tasksCreated      Task[]                  @relation("TaskCreatedBy")
  tasksAssigned     TaskAssignee[]
  ideas             Idea[]
  recurringCreated  RecurringTask[]         @relation("RecurringCreatedBy")
  recurringAssigned RecurringTaskAssignee[]
  pushSubscriptions PushSubscription[]
  shoppingAdded     ShoppingItem[]
  recipesCreated    Recipe[]
  expensesPaid      Expense[]               @relation("ExpensePaidBy")
  expenseShares     ExpenseShare[]
  settlementsSent   Settlement[]            @relation("SettlementFrom")
  settlementsGot    Settlement[]            @relation("SettlementTo")
}

/// Pertenencia de una persona a una casa.
model HouseholdMember {
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// admin | miembro
  role        String    @default("miembro")
  /// Uno de MEMBER_COLORS (@hogar/shared)
  color       String    @default("azul")
  joinedAt    DateTime  @default(now())

  @@id([householdId, userId])
  @@index([userId])
}

/// Sesión iniciada. La cookie lleva un token aleatorio; aquí se guarda su hash.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Enlace de invitación de un solo uso para unirse a una casa.
model Invitation {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

// ---------- Tareas ----------

/// Personas asignadas a una tarea (puede haber varias).
model TaskAssignee {
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Task {
  id          String         @id @default(uuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  notes       String         @default("")
  /// por_hacer | en_curso | hecho
  status      String         @default("por_hacer")
  /// alta | media | baja
  priority    String         @default("media")
  /// AAAA-MM-DD
  due         String?
  category    String?
  assignees   TaskAssignee[]
  createdById String
  createdBy   User           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  idea        Idea?
  /// Plantilla que la creó, si es una tarea recurrente
  recurringId String?
  recurring   RecurringTask? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([householdId, status])
  @@index([recurringId])
}

/// Plantilla de una tarea que se crea sola cada cierto tiempo (ver recurring.ts en @hogar/shared).
model RecurringTask {
  id          String                  @id @default(uuid())
  householdId String
  household   Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  notes       String                  @default("")
  priority    String                  @default("media")
  category    String?
  assignees   RecurringTaskAssignee[]
  /// dias | semanas | meses | dias_semana
  frequency   String
  interval    Int                     @default(1)
  /// Días de la semana (1 = lunes … 7 = domingo) separados por comas, solo en dias_semana
  weekdays    String                  @default("")
  /// AAAA-MM-DD
  startDate   String
  /// Fecha en la que toca crear la próxima tarea (AAAA-MM-DD)
  nextDate    String
  /// Última fecha ya tratada, haya creado tarea o no (AAAA-MM-DD)
  lastDate    String?
  active      Boolean                 @default(true)
  tasks       Task[]
  createdById String
  createdBy   User                    @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([active, nextDate])
  @@index([householdId])
}

model RecurringTaskAssignee {
  recurringId String
  recurring   RecurringTask @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([recurringId, userId])
  @@index([userId])
}

/// Dispositivo (navegador) que ha aceptado recibir avisos push.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Ajustes que genera el propio servidor, como las claves VAPID de los avisos push.
model AppSetting {
  key   String @id
  value String
}

// ---------- Ideas ----------

model Idea {
  id           String    @id @default(uuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title        String
  description  String    @default("")
  /// nueva | en_valoracion | aceptada | descartada
  status       String    @default("nueva")
  category     String?
  proposedById String
  proposedBy   User      @relation(fields: [proposedById], references: [id])
  taskId       String?   @unique
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([householdId, status])
}

/// Artículo de la lista de la compra de una casa (una sola lista por casa).
model ShoppingItem {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  /// productKey(name): para no repetir el mismo producto en la lista
  key         String
  quantity    String?
  /// Una de SHOPPING_SECTIONS (@hogar/shared)
  section     String
  /// Ya está en el carro
  done        Boolean   @default(false)
  addedById   String
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([householdId, key])
}

/// Producto que ya se ha comprado en la casa: recuerda su sección y sirve para los habituales.
model ShoppingProduct {
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// productKey(name)
  key         String
  name        String
  section     String
  quantity    String?
  /// Veces que se ha añadido a la lista
  count       Int       @default(1)
  lastUsedAt  DateTime  @default(now())

  @@id([householdId, key])
}

/// Receta del recetario de una casa.
model Recipe {
  id          String      @id @default(uuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  /// primero | segundo | unico | postre
  kind        String
  /// rapido | medio | largo
  duration    String
  minutes     Int?
  /// Raciones para las que están pensadas las cantidades
  servings    Int
  /// JSON: Ingredient[] (@hogar/shared). Siempre se leen y se guardan juntos.
  ingredients String      @default("[]")
  /// JSON: string[] con los pasos en orden
  steps       String      @default("[]")
  notes       String      @default("")
  /// Archivo de la foto en PHOTOS_DIR, o null
  photo       String?
  menu        MenuEntry[]
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([householdId])
}

/// Plato del menú semanal: un día, comida o cena, y para cuántas raciones.
model MenuEntry {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// AAAA-MM-DD
  date        String
  /// comida | cena
  meal        String
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  servings    Int
  createdAt   DateTime  @default(now())

  @@index([householdId, date])
}

/// Gasto de la casa. Importes en céntimos. El reparto se guarda al crearlo (ExpenseShare), así que
/// no cambia aunque luego entre o salga alguien de la casa.
model Expense {
  id          String         @id @default(uuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  concept     String
  amount      Int
  /// AAAA-MM-DD
  date        String
  category    String?
  notes       String         @default("")
  paidById    String
  paidBy      User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  shares      ExpenseShare[]
  /// Factura fija que se pagó con este gasto
  billId      String?
  bill        Bill?          @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([householdId, date])
}

/// Lo que le toca pagar a cada persona de un gasto (en céntimos; suma el importe del gasto).
model ExpenseShare {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  amount    Int

  @@id([expenseId, userId])
  @@index([userId])
}

/// Pago entre dos personas para quedar en paz.
model Settlement {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromId      String
  from        User      @relation("SettlementFrom", fields: [fromId], references: [id])
  toId        String
  to          User      @relation("SettlementTo", fields: [toId], references: [id])
  amount      Int
  /// AAAA-MM-DD
  date        String
  createdById String
  createdAt   DateTime  @default(now())

  @@index([householdId, date])
}

/// Factura fija (luz, agua, internet…) que llega cada N meses.
model Bill {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  /// Importe aproximado en céntimos
  amount      Int?
  /// Cada cuántos meses
  interval    Int       @default(1)
  /// AAAA-MM-DD
  nextDue     String
  active      Boolean   @default(true)
  notes       String    @default("")
  expenses    Expense[]
  createdAt   DateTime  @default(now())

  @@index([householdId])
}
